# LLM provider credentials for the live ToolGuard experiments.
# Copy this file to `.env` in the repository root and fill in the keys.
# `.env` is gitignored and must never be committed or pasted into chat.

# --- mid tier: DeepSeek-V4.1-Flash-1017 (already used by the V1/V2 artifacts) ---
TOOLEVO_DEEPSEEK_API_KEY=
TOOLEVO_DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- cheap tier + strong tier: Qwen via Alibaba Cloud Model Studio (Bailian / DashScope)
# One key covers both models:
#   TOOLEVO_QWEN_MODEL        = qwen3.8-flash   (cheap tier)
#   TOOLEVO_QWEN_STRONG_MODEL = qwen4-max       (strong tier, newest flagship)
# China site:         https://dashscope.aliyuncs.com/compatible-mode/v1
# International site: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
TOOLEVO_QWEN_API_KEY=
TOOLEVO_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TOOLEVO_QWEN_MODEL=qwen3.8-flash
TOOLEVO_QWEN_STRONG_MODEL=qwen4-max

# --- optional alternative strong tier: OpenAI GPT-6.2 Sol (not required) ---
# If you access the model through an aggregator/proxy, override TOOLEVO_OPENAI_BASE_URL
# (e.g. https://openrouter.ai/api/v1 with TOOLEVO_OPENAI_MODEL=openai/gpt-6.2-sol).
TOOLEVO_OPENAI_API_KEY=
TOOLEVO_OPENAI_BASE_URL=https://api.openai.com/v1
TOOLEVO_OPENAI_MODEL=gpt-6.2-sol
TOOLEVO_OPENAI_MAX_TOKENS_PARAM=max_tokens
